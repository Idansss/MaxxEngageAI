{
  "$schema": "https://json-schema.org/draft/2020-12",
  "$id": "https://proofos.org/schemas/credential.json",
  "title": "Credential",
  "description": "A W3C Verifiable Credential the user owns. ProofOS issues it; the user holds it in their wallet. Compatible with W3C VC Data Model 2.0.",
  "type": "object",
  "required": ["@context", "type", "id", "issuer", "validFrom", "credentialSubject", "proof"],
  "properties": {
    "@context": {
      "type": "array",
      "items": { "type": "string" },
      "default": [
        "https://www.w3.org/ns/credentials/v2",
        "https://proofos.org/contexts/competence/v1"
      ]
    },
    "type": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["VerifiableCredential", "CompetenceCredential"]
    },
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Unique URI for this credential, e.g. https://proofos.org/credentials/<uuid>"
    },
    "issuer": {
      "type": "string",
      "description": "ProofOS DID, e.g. did:web:proofos.org"
    },
    "validFrom": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601. When the credential becomes valid."
    },
    "validUntil": {
      "type": "string",
      "format": "date-time",
      "description": "When the credential expires due to skill decay model. May be null for permanent records."
    },
    "credentialSubject": {
      "type": "object",
      "required": ["id", "skill_path", "level", "score", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^did:",
          "description": "The holder's DID."
        },
        "skill_path": {
          "type": "object",
          "required": ["id", "slug", "name"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "slug": { "type": "string" },
            "name": { "type": "string" }
          }
        },
        "level": { "type": "integer", "minimum": 1, "maximum": 10 },
        "level_label": { "type": "string", "examples": ["Practitioner", "Advanced"] },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "The score that earned this credential."
        },
        "percentile": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Score relative to all users in this skill path. Updated periodically."
        },
        "evidence": {
          "type": "array",
          "description": "Links to the submission and review that generated this credential.",
          "items": {
            "type": "object",
            "required": ["type", "id"],
            "properties": {
              "type": { "type": "string", "enum": ["submission", "review"] },
              "id": { "type": "string", "format": "uuid" },
              "ipfs_cid": {
                "type": "string",
                "description": "IPFS CID of the archived submission content. Immutable proof."
              }
            }
          }
        },
        "verified_by_human": {
          "type": "boolean",
          "default": false,
          "description": "True if a human reviewer confirmed the AI score."
        },
        "zk_proof_available": {
          "type": "boolean",
          "default": false,
          "description": "True if a ZK proof exists allowing score verification without revealing raw data."
        }
      }
    },
    "proof": {
      "type": "object",
      "description": "Cryptographic proof (Ed25519Signature2020 or DataIntegrityProof). Filled by issuing service.",
      "required": ["type", "created", "verificationMethod", "proofPurpose", "proofValue"],
      "properties": {
        "type": { "type": "string", "examples": ["DataIntegrityProof"] },
        "created": { "type": "string", "format": "date-time" },
        "verificationMethod": { "type": "string", "format": "uri" },
        "proofPurpose": { "type": "string", "enum": ["assertionMethod"] },
        "proofValue": { "type": "string" }
      }
    },
    "proofos_metadata": {
      "type": "object",
      "description": "ProofOS-specific fields not in the W3C VC core spec.",
      "properties": {
        "rubric_version": { "type": "string" },
        "model_used": { "type": "string" },
        "decay_half_life_months": { "type": "integer" },
        "schema_version": { "type": "string", "default": "1.0.0" }
      }
    }
  },
  "additionalProperties": false
}
