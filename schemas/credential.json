{
  "$schema": "https://json-schema.org/draft/2020-12",
  "$id": "https://maxx-engage.io/schemas/credential.json",
  "title": "Credential",
  "description": "Maxx Engage Phase 1 credential registry record. The internal primary key may remain a UUID, but the public credential identifier must be stable and unguessable.",
  "type": "object",
  "required": [
    "id",
    "userId",
    "rubricId",
    "rubricVersion",
    "skillName",
    "category",
    "score",
    "maxScore",
    "passed",
    "passThreshold",
    "scoresByCategory",
    "submissionHash",
    "gradedAt",
    "gradedBy",
    "flaggedForReview",
    "revoked",
    "publicVisible"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cred_[A-Za-z0-9_-]{10,32}$",
      "description": "Public credential ID, e.g. cred_abc123xyz."
    },
    "internalId": {
      "type": "string",
      "format": "uuid",
      "description": "Optional database UUID. Never used as the public credential ID."
    },
    "userId": { "type": "string", "format": "uuid" },
    "rubricId": { "type": "string" },
    "rubricVersion": { "type": "string", "default": "1" },
    "skillName": { "type": "string" },
    "category": { "type": "string" },
    "score": { "type": "number", "minimum": 0 },
    "maxScore": { "type": "number", "minimum": 1, "default": 100 },
    "passed": { "type": "boolean" },
    "passThreshold": { "type": "number", "minimum": 0 },
    "scoresByCategory": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["points", "max", "comment", "suggestion"],
        "properties": {
          "points": { "type": "number" },
          "max": { "type": "number" },
          "comment": { "type": "string" },
          "suggestion": { "type": "string" }
        }
      }
    },
    "submissionHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of the original submission."
    },
    "gradedAt": { "type": "string", "format": "date-time" },
    "gradedBy": { "type": "string", "enum": ["ai", "ai+human", "human"] },
    "humanReviewerId": { "type": ["string", "null"], "format": "uuid" },
    "flaggedForReview": { "type": "boolean" },
    "flagReason": { "type": ["string", "null"] },
    "revoked": { "type": "boolean" },
    "revokedAt": { "type": ["string", "null"], "format": "date-time" },
    "revokedReason": { "type": ["string", "null"] },
    "publicVisible": { "type": "boolean" },
    "vcDocument": {
      "type": ["object", "null"],
      "description": "Optional W3C VC payload stored alongside the Phase 1 registry record."
    }
  },
  "additionalProperties": false
}
