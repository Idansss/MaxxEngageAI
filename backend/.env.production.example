# Production backend env template. Do not commit real production secrets.

ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8000

# Lock CORS to the public frontend only. Do not include localhost or "*".
CORS_ORIGINS=https://maxx-engage-ai.vercel.app

# Database and Supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PRIMARY_GRADING_MODEL=claude-sonnet-4-6
SECONDARY_GRADING_MODEL=gpt-4o
MODEL_DISAGREEMENT_SCORE_THRESHOLD=10

# Admin
ADMIN_EMAILS=

# Proof-of-personhood
GITCOIN_API_KEY=
GITCOIN_SCORER_ID=12060
GITHUB_TOKEN=

# Credential signing and ZK
ISSUER_PRIVATE_KEY_B64=
ISSUER_PUBLIC_KEY_MULTIBASE=
ISSUER_DID=
ZK_SECRET_KEY=

# Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.10
OTEL_ENABLED=false
OTEL_SERVICE_NAME=proofos-api
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=proofos

# Safety
SAFETY_CHECKS_ENABLED=true
SAFETY_FORCE_HUMAN_REVIEW=true

# Optional webhooks
WEBHOOK_URL=
WEBHOOK_SECRET=
