# Production backend env template. Do not commit real production secrets.

ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8000

# Lock CORS to the public frontend only. Do not include localhost or "*".
CORS_ORIGINS=https://maxx-engage-ai.vercel.app

# Database and Supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
PRIMARY_GRADING_MODEL=claude-sonnet-4-6
SECONDARY_GRADING_MODEL=gpt-4o
TERTIARY_GRADING_MODEL=gemini-1.5-pro
MODEL_DISAGREEMENT_SCORE_THRESHOLD=10
MODEL_CROSSCHECK_ENABLED=true

# Admin
ADMIN_EMAILS=

# Proof-of-personhood
GITCOIN_API_KEY=
GITCOIN_SCORER_ID=12060
GITHUB_TOKEN=
GITHUB_REPO_OWNER=Idansss
GITHUB_REPO_NAME=MaxxEngageAI
PUBLIC_GITHUB_URL=https://github.com/Idansss/MaxxEngageAI
DISCORD_INVITE_URL=

# Trusted public knowledge retrieval
KNOWLEDGE_RETRIEVAL_ENABLED=true
WIKIPEDIA_API_URL=https://en.wikipedia.org/api/rest_v1
WIKIPEDIA_ACTION_API_URL=https://en.wikipedia.org/w/api.php
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
KNOWLEDGE_MAX_SOURCES=4

# Optional IPFS pinning for issued credentials
IPFS_PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Credential signing and ZK
ISSUER_PRIVATE_KEY_B64=
ISSUER_PUBLIC_KEY_MULTIBASE=
ISSUER_DID=
ZK_SECRET_KEY=

# Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.10
OTEL_ENABLED=false
OTEL_SERVICE_NAME=maxx-engage-api
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=maxx-engage

# Safety
SAFETY_CHECKS_ENABLED=true
SAFETY_FORCE_HUMAN_REVIEW=true

# Optional webhooks
WEBHOOK_URL=
WEBHOOK_SECRET=
