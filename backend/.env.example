# Copy to .env and fill in. Never commit .env.
# Rotation policy: rotate all keys every 90 days.

# ── AI Providers (use at least two; cross-check outputs) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Primary model for grading (Claude preferred for reasoning transparency)
PRIMARY_GRADING_MODEL=claude-sonnet-4-6
SECONDARY_GRADING_MODEL=gpt-4o

# ── Database ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── App Config ────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ── Credential Issuance ───────────────────────────────────────────────────────
ISSUER_DID=did:web:proofos.org
# Path to Ed25519 private key for signing VCs (never commit the key itself)
ISSUER_PRIVATE_KEY_PATH=./secrets/issuer_key.pem

# ── Scoring Thresholds ────────────────────────────────────────────────────────
AI_CONFIDENCE_THRESHOLD=0.70     # Below this → human review queue
PASS_SCORE_THRESHOLD=70          # Minimum score to earn a credential (0-100)
HUMAN_REVIEW_SCORE_BAND=5        # Scores within ±5 of pass threshold → human review
