# Copy to .env and fill in. Never commit .env.
# Rotation policy: rotate all keys every 90 days.

# ── AI Providers (use at least two; cross-check outputs) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Primary model for grading (Claude preferred for reasoning transparency)
PRIMARY_GRADING_MODEL=claude-sonnet-4-6
SECONDARY_GRADING_MODEL=gpt-4o
MODEL_DISAGREEMENT_SCORE_THRESHOLD=10

# ── Database ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── App Config ────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.10
OTEL_ENABLED=false
OTEL_SERVICE_NAME=proofos-api
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=proofos

# Safety and bias checks
SAFETY_CHECKS_ENABLED=true
SAFETY_FORCE_HUMAN_REVIEW=true

# ── W3C VC Issuer Keypair ─────────────────────────────────────────────────────
# Generate ONCE with:  cd backend && python scripts/generate_issuer_key.py
# Rotating this key invalidates all previously issued credential signatures.
ISSUER_PRIVATE_KEY_B64=        # Raw Ed25519 private key, base64-encoded (KEEP SECRET)
ISSUER_PUBLIC_KEY_MULTIBASE=   # z6Mk... multibase public key (safe to publish)
ISSUER_DID=                    # did:key:z6Mk... derived from the public key above

# ── Proof-of-Personhood ───────────────────────────────────────────────────────
# Gitcoin Passport Scorer API — create a scorer at https://scorer.gitcoin.co/
GITCOIN_API_KEY=
GITCOIN_SCORER_ID=

# GitHub API token (optional — raises rate limit 60→5000 req/hr for stamp verification)
# Create at https://github.com/settings/tokens (no scopes needed)
GITHUB_TOKEN=

# ── ZK Commitments ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Rotation requires re-issuing all existing score commitments.
ZK_SECRET_KEY=change-me-in-production

# ── Outbound Webhooks (optional) ─────────────────────────────────────────────
# ProofOS will POST to WEBHOOK_URL on key events (human_review_queued, appeal_received,
# appeal_resolved, credential_issued). Leave blank to disable.
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_URL=
WEBHOOK_SECRET=

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=you@example.com

# ── Scoring Thresholds ────────────────────────────────────────────────────────
AI_CONFIDENCE_THRESHOLD=0.70     # Below this → human review queue
PASS_SCORE_THRESHOLD=70          # Minimum score to earn a credential (0-100)
HUMAN_REVIEW_SCORE_BAND=5        # Scores within ±5 of pass threshold → human review
